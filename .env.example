# 複製成 .env 再填。.env 不進版控，也不會被帶進映像檔。
# 操作手冊：docs/OPERATIONS.md。

# 資料庫有兩個角色，各一組密碼。都只用英文字母與數字：它們會被放進連線字串，分號、等號、引號會讓連線字串解析錯誤。
# 產生一組：openssl rand -hex 24
#
# 資料表的擁有者 pmtool：遷移、備份、還原用它。只在資料庫第一次建立時設定，之後改這裡不會改到資料庫裡的密碼。
POSTGRES_PASSWORD=
# 執行用的角色 pmtool_app：api 平常用它連資料庫，只能讀寫資料，改不了資料表結構。
# 改了之後跑一次 bash scripts/ops/deploy-local.sh --no-build，資料庫裡的密碼會跟著更新。
POSTGRES_APP_PASSWORD=

# 第一個組織與它的擁有者。只有資料庫裡還沒有任何帳號時才會用到。
BOOTSTRAP_ORGANIZATION_NAME=範例組織
BOOTSTRAP_ADMIN_NAME=管理員
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 登入用的密碼，至少 10 個字元。
BOOTSTRAP_ADMIN_PASSWORD=

# 網頁開在 http://localhost:這個連接埠。只綁本機，別的機器連不進來。
PMTOOL_PORT=8080
# 備份檔放在主機的哪個目錄：相對於 repo 根目錄，或寫絕對路徑。docker compose down -v 刪不到它。
BACKUP_DIR=./backups
# 附件的檔案放在主機的哪個資料夾：相對於 repo 根目錄，或寫絕對路徑。裡面是使用者上傳的真實檔案，不進版控。
# 備份時會增量複製到 BACKUP_DIR 底下的 attachments/。另起隔離的環境時一定要換成自己的（docs/OPERATIONS.md 第 9 節）。
ATTACHMENTS_DIR=./data/attachments
# 排程備份留最新的幾份。帶標籤的備份（手動、部署前、還原前）不算在內，也不會被自動刪掉。
BACKUP_KEEP=14
# 最新的排程備份超過幾小時就做一份新的。每小時檢查一次，所以 Mac 睡著錯過時間，醒來後會補做。
BACKUP_INTERVAL_HOURS=24
# 備份檔名與記錄用的時區。
TZ=Asia/Taipei
# AI 的 OpenAI 相容端點（例如主機上自架的 Ollama，基底網址 http://host.docker.internal:11434/v1）要打開才連得到。
# 預設關著：伺服器會照管理員填的網址去連，不擋的話等於讓人拿它掃內網（docs/DEPLOYMENT.md 第 1.8 節）。
# AI_ALLOW_PRIVATE_ENDPOINTS=true
# 寄信的主機在公司內網（私有網段）時要打開才存得進去、寄得出去。預設關著，理由同上（docs/DEPLOYMENT.md 第 1.7 節）。
# EMAIL_ALLOW_PRIVATE_HOSTS=true
# 附件的容量上限（GiB，0 是不限）：組織的總量預設 20、每個人過去 24 小時的上傳量預設 2。
# ATTACHMENT_QUOTA_ORGANIZATION_GIB=20
# ATTACHMENT_QUOTA_PERSON_DAILY_GIB=2
# 容器的資源上限（api 平常不到 200 MB）。api 被 OOM 殺掉（docker inspect 的 OOMKilled 是 true）才調高。見 docs/OPERATIONS.md 第 2 節。
# API_MEM_LIMIT=1g
# API_PIDS_LIMIT=512
# BACKUP_MEM_LIMIT=512m
# BACKUP_PIDS_LIMIT=128
# 備份加密（選用）：填 age 的公鑰（age1…），資料庫的備份在寫進備份目錄之前就加密成 .dump.age；不填照舊存明文的 .dump。
# 私鑰不要放這裡（也不要進 repo）：還原時另外給（BACKUP_AGE_IDENTITY_FILE=<私鑰檔的絕對路徑> bash scripts/ops/restore.sh …）。
# 附件的備份不加密。產生金鑰與完整步驟：docs/OPERATIONS.md 第 3 節。
# BACKUP_AGE_RECIPIENT=
# Data Protection 憑證（選用，建議）：加密工作階段 Cookie、AI 金鑰與寄信密碼用的金鑰。憑證檔放在 repo 外面，
# DATAPROTECTION_DIR 是它所在的資料夾（絕對路徑，唯讀掛進 api 與 migrate），DATAPROTECTION_CERT_FILE 是裡面的檔名。
# 產生、另外保存與設了之後的後果：docs/OPERATIONS.md 第 20 節。
# DATAPROTECTION_DIR=/Users/<你的帳號>/kumi-secrets
# DATAPROTECTION_CERT_FILE=dataprotection.pfx
# DATAPROTECTION_CERT_PASSWORD=
# 設成 true 時，憑證掛不上就啟動失敗，不會悄悄退回明文。
# DATAPROTECTION_REQUIRE_CERTIFICATE=true
# 換憑證時舊的檔名（同一個資料夾）。
# DATAPROTECTION_PREVIOUS_CERT_FILE=
