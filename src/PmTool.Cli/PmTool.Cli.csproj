<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>kumi</AssemblyName>
    <RootNamespace>PmTool.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kumi</ToolCommandName>
    <PackageId>PmTool.Cli</PackageId>
    <Description>Kumi 的命令列工具：登入、查詢與修改項目、匯出與套用專案藍圖。</Description>
    <!-- 打包出來的工具是一般的 dotnet tool；版本在發行時再決定。 -->
    <Version>0.20.0</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(KumiStandalone)' == 'true'">
    <!-- kumi update 靠它分辨「從伺服器下載的單一執行檔」與 dotnet tool：後者的檔案在 NuGet 的資料夾裡，不能自己換掉自己。 -->
    <AssemblyMetadata Include="KumiDistribution" Value="standalone" />
  </ItemGroup>

  <ItemGroup>
    <!-- kumi licenses 印的三份文件。單一執行檔下載時只有一個檔案，授權與第三方聲明只能內嵌在裡面。
         路徑寫死、不用萬用字元：少了檔案時建置要失敗，不能悄悄少內嵌一份（兩個 Dockerfile 建 CLI 的階段都要先複製這三個檔）。 -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Kumi.LICENSE" />
    <EmbeddedResource Include="..\..\NOTICE" LogicalName="Kumi.NOTICE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="Kumi.THIRD-PARTY-NOTICES" />
  </ItemGroup>

  <ItemGroup>
    <!-- kumi skill install 裝的 skill 內嵌在執行檔裡（單一執行檔只有一個檔案，沒辦法另外附資料夾）。
         資源名稱是 Kumi.Skills/<skill 名稱>/<相對路徑>。萬用字元找不到檔案時不會報錯，所以下面另外檢查兩份 SKILL.md 在不在；
         兩個 Dockerfile 建 CLI 的階段都要先複製 skills/。 -->
    <EmbeddedResource Include="..\..\skills\**\*" Exclude="..\..\skills\**\.DS_Store"
                      LogicalName="Kumi.Skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RequireSkills" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\skills\kumi\SKILL.md') Or !Exists('$(MSBuildThisFileDirectory)..\..\skills\kumi-planning\SKILL.md')"
           Text="找不到 skills/kumi 或 skills/kumi-planning（kumi skill install 要內嵌它們；建置映像檔時要一起複製）。" />
  </Target>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\PmTool.Blueprint\PmTool.Blueprint.csproj" />
    <InternalsVisibleTo Include="PmTool.Cli.Tests" />
    <InternalsVisibleTo Include="PmTool.Api.Tests" />
  </ItemGroup>

</Project>
